[project]
requires = ["nodejs-24"]
entrypoint = "."

[dev]
build = ["bash", "-c", "cd frontend && pnpm install && pnpm run build"]
run = ["bash", "-c", "cd frontend/dist && node server.cjs"]

[deploy]
build = ["bash", "-c", "cd frontend && pnpm install && pnpm run build"]
run = ["bash", "-c", "cd frontend/dist && node server.cjs"]
