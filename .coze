[project]
requires = ["nodejs-24"]
entrypoint = "frontend"

[dev]
build = ["bash", "-c", "cd frontend && pnpm install"]
run = ["bash", "-c", "cd frontend && pnpm run dev -- --port 5000 --host"]

[deploy]
build = ["bash", "-c", "cd frontend && pnpm install && pnpm run build"]
run = ["bash", "-c", "cd frontend && node server.cjs"]
