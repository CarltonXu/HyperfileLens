[project]
requires = ["nodejs-24"]
entrypoint = "."

[dev]
build = ["bash", "-c", "cd frontend && pnpm install && pnpm run build && cp server.cjs dist/"]
run = ["bash", "-c", "cd frontend && node server.cjs"]

[deploy]
build = ["bash", "-c", "cd frontend && pnpm install && pnpm run build && cp server.cjs dist/"]
run = ["bash", "-c", "cd frontend && node server.cjs"]
