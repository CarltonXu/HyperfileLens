# HyperFileLens development environment
# Usage:
#   cp env.dev.sample .env.dev
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d --build

APP_NAME=HyperFileLens
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=dev-secret-key-for-local-development-only

# Build mirrors. Change to official sources if needed.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
KOPIA_VERSION=0.22.3
KOPIA_DOWNLOAD_BASE_URL=https://github.com/kopia/kopia/releases/download/v0.22.3
KOPIA_DOWNLOAD_TIMEOUT=120

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=true
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=hyperfilelens_dev
POSTGRES_USER=hyperfilelens_dev
POSTGRES_PASSWORD=hyperfilelens_dev
POSTGRES_PORT=5432

# Initial superuser for local development.
HFL_ADMIN_EMAIL=admin@example.com
HFL_ADMIN_PASSWORD=Admin123456!
HFL_ADMIN_FIRST_NAME=Dev
HFL_ADMIN_LAST_NAME=Admin

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
PUBLIC_CONTROL_PLANE_URL=http://localhost:8000

SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=false
SECURE_SSL_REDIRECT=false

LOG_LEVEL=DEBUG
LOG_FILE=/app/logs/app.log

BACKEND_PORT=8000
FRONTEND_PORT=5173

LICENSE_PUBLIC_KEY=
LICENSE_PUBLIC_KEYS=

GATEWAY_WS_PROTOCOL=ws
GATEWAY_ID=
GATEWAY_INSTALL_TOKEN=
GATEWAY_API_TOKEN=
GATEWAY_NAME=dev-gateway
GATEWAY_LOG_LEVEL=DEBUG

PROXY_API_TOKEN=
PROXY_ROLE=agent
PROXY_SOURCE_PATH=/data
