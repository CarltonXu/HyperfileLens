# =====================================================
# HyperFileLens Environment Configuration
# =====================================================
# Copy this file to .env or .env.dev and configure

# =====================================================
# Application
# =====================================================
APP_NAME=HyperFileLens
APP_VERSION=1.0.0
APP_DEBUG=false

# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://your-domain.com

# =====================================================
# Database (PostgreSQL)
# =====================================================
POSTGRES_DB=hyperfilelens
POSTGRES_USER=hyperfilelens
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://hyperfilelens:password@localhost:5432/hyperfilelens

# =====================================================
# Redis
# =====================================================
REDIS_PASSWORD=change-me-in-production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Redis URL (alternative to individual settings)
# REDIS_URL=redis://:password@localhost:6379/0

# =====================================================
# Celery
# =====================================================
CELERY_BROKER_URL=redis://:change-me-in-production@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-in-production@localhost:6379/0

# =====================================================
# Storage
# =====================================================
# Local storage path
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# S3 Compatible Storage (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=hyperfilelens-backups
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_S3_REGION_NAME=us-east-1

# =====================================================
# AI Configuration (optional)
# =====================================================
# OpenAI API
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4
# OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# =====================================================
# Email (optional)
# =====================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=HyperFileLens <noreply@hyperfilelens.io>

# =====================================================
# Security
# =====================================================
# Session cookie settings
SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# CSRF settings
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# =====================================================
# CORS (Cross-Origin Resource Sharing)
# =====================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://your-domain.com

# =====================================================
# Ports (for Docker)
# =====================================================
APP_HTTP_PORT=8000
FLOWER_PORT=5555
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
