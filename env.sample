# =====================================================
# HyperFileLens Environment Configuration
# =====================================================
# Copy this file to .env or .env.dev and configure

# =====================================================
# Application
# =====================================================
APP_NAME=HyperFileLens
APP_VERSION=1.0.0
APP_DEBUG=false

# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:8000,https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5001,http://localhost:8000,https://your-domain.com
CORS_ALLOW_ALL_ORIGINS=false
DJANGO_TIME_ZONE=UTC

# =====================================================
# Database (PostgreSQL)
# =====================================================
POSTGRES_DB=hyperfilelens
POSTGRES_USER=hyperfilelens
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# Database URL (alternative to individual settings)
# DATABASE_URL=postgresql://hyperfilelens:password@localhost:5432/hyperfilelens

# =====================================================
# Redis
# =====================================================
REDIS_PORT=6379

# Redis URL is generated by docker-compose for container deployments.

# =====================================================
# Celery
# =====================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# =====================================================
# Storage
# =====================================================
# Local storage path
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# S3 Compatible Storage (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET_NAME=hyperfilelens-backups
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_S3_REGION_NAME=us-east-1

# =====================================================
# AI Provider is configured from Settings -> AI Insights in the web UI.

# =====================================================
# Email (optional)
# =====================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=HyperFileLens <noreply@hyperfilelens.io>

# =====================================================
# Security
# =====================================================
# Session cookie settings
SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# CSRF settings
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# =====================================================
# CORS (Cross-Origin Resource Sharing)
# =====================================================
# Ports (for Docker)
# =====================================================
BACKEND_PORT=8000
FRONTEND_PORT=5001

# Optional colocated Gateway Agent.
# Usually you create a Gateway in the UI and copy its ID/install token here,
# then start it with: docker compose --profile gateway up -d gateway-agent
GATEWAY_SERVER_URL=http://control:8000
GATEWAY_WS_PROTOCOL=ws
GATEWAY_ID=
GATEWAY_INSTALL_TOKEN=
GATEWAY_API_TOKEN=
GATEWAY_NAME=gateway-01
GATEWAY_LOG_LEVEL=INFO

# Optional colocated Proxy Agent.
# Usually Proxy runs on source servers instead of the control-plane host.
# Start with: docker compose --profile proxy up -d proxy-agent
PROXY_SERVER_URL=http://control:8000
PROXY_API_TOKEN=
PROXY_ROLE=agent
PROXY_SOURCE_PATH=/data
