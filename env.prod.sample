# HyperFileLens production environment
# Usage:
#   cp env.prod.sample .env.prod
#   edit .env.prod
#   docker compose --env-file .env.prod up -d --build

APP_NAME=HyperFileLens
APP_VERSION=1.0.0
DEBUG=false

# Build mirrors. These speed up Docker builds in mainland China.
# Replace with official sources if your server has better direct internet access:
#   PIP_INDEX_URL=https://pypi.org/simple
#   PIP_TRUSTED_HOST=pypi.org
#   NPM_REGISTRY=https://registry.npmjs.org
#   GOPROXY=https://proxy.golang.org,direct
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct

# Kopia packages are downloaded during backend image build and then exposed
# under /downloads/packages/kopia/ for proxy/gateway installers.
KOPIA_VERSION=0.22.3
KOPIA_DOWNLOAD_BASE_URL=https://github.com/kopia/kopia/releases/download/v0.22.3
KOPIA_DOWNLOAD_TIMEOUT=120

# Replace with a long random secret before deployment.
SECRET_KEY=change-this-to-a-long-random-production-secret

# Public host names or IPs that users and agents use to reach Nginx.
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,control
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CORS_ALLOW_ALL_ORIGINS=false
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=hyperfilelens
POSTGRES_USER=hyperfilelens
POSTGRES_PASSWORD=change-this-postgres-password

# Initial superuser created by control-init after database migrations.
# If HFL_ADMIN_PASSWORD is empty, a random password is generated and printed
# once in the control-init logs.
HFL_ADMIN_EMAIL=admin@example.com
HFL_ADMIN_PASSWORD=change-this-admin-password
HFL_ADMIN_FIRST_NAME=System
HFL_ADMIN_LAST_NAME=Administrator

# Bind database/cache to localhost by default. Remove or change only when
# another host must connect directly.
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# Externally reachable URL exposed by Nginx/Ingress/LB. This is used to
# generate Proxy/Gateway install commands and WebSocket endpoints.
PUBLIC_CONTROL_PLANE_URL=https://your-domain.com
PUBLIC_HTTP_PORT=5001

SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=false
SECURE_SSL_REDIRECT=false

LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Ed25519 public key used to verify HFL-LIC-v1 signed license tokens.
# Keep the private key only in the offline/internal license issuing environment.
# Use \n for line breaks when storing PEM content in a single-line env file.
LICENSE_PUBLIC_KEY=

# Optional key rotation support. Separate multiple PEM public keys with "||".
LICENSE_PUBLIC_KEYS=

# Optional colocated Gateway Agent. Usually Gateway runs on a separate node.
GATEWAY_WS_PROTOCOL=wss
GATEWAY_ID=
GATEWAY_INSTALL_TOKEN=
GATEWAY_API_TOKEN=
GATEWAY_NAME=gateway-01
GATEWAY_LOG_LEVEL=INFO

# Optional colocated Proxy Agent. Usually Proxy runs on source servers.
PROXY_API_TOKEN=
PROXY_ROLE=agent
PROXY_SOURCE_PATH=/data
